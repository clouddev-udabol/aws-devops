# ============================================================
# iaapp — UDABOL — .gitignore
# ============================================================

# CloudFormation packaging
packaged-*.yaml
packaged-*.json
*.pkg.yaml

# AWS SAM
.aws-sam/
samconfig.toml

# AWS CLI / credenciales locales (defensiva — nunca deberían aparecer)
.aws/
*.pem
*.key
*-credentials.json
credentials
config

# Variables de entorno locales
.env
.env.local
.env.*.local

# Editores / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Python (para hooks pre-commit y scripts)
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
venv/
.venv/

# Node (si se agregan validators JS más adelante)
node_modules/
npm-debug.log*

# Logs y artefactos
*.log
logs/
*.cache

# CDK output (si en el futuro se agrega)
cdk.out/

# Archivos temporales del session manager local
session-ses_*.md
memoria.md

# Drawio backups
*.drawio.bkp
~$*

# Archivos pesados de documentación binaria que no deben versionarse en root
*.tmp
